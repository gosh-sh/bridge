!poseidon-proof/data/keccak_evm_calldata.bin
!poseidon-proof/data/keccak_verifier_deployment.bin
deposit-prover/params/
*.pk
*.snark
*.bkp

# KZG parameters (downloaded from trusted setup, not stored in git)
deposit-prover/data/*.srs

# AN→ETH gnark wrapper build artifacts (per-circuit, under bridge-snark-utils)
# The deposit-prover/gnark-wrapper/ tree was retired in Phase 4.3 (2026-05-17).
crates/bridge-snark-utils/gnark-wrappers/circuit-*/circuit.r1cs
crates/bridge-snark-utils/gnark-wrappers/circuit-*/proving.key
crates/bridge-snark-utils/gnark-wrappers/circuit-*/verification.key
crates/bridge-snark-utils/gnark-wrappers/circuit-*/groth16_proof.hex
crates/bridge-snark-utils/gnark-wrappers/circuit-*/groth16_output.json
crates/bridge-snark-utils/gnark-wrappers/circuit-1a/circuit-1a
crates/bridge-snark-utils/gnark-wrappers/circuit-1b/circuit-1b
crates/bridge-snark-utils/gnark-wrappers/circuit-2/circuit-2

# Prompt files
*.prompt
!intergation.prompt

# Build artifacts
cache/
out/

# Review packs for partners (produced by build_pack.sh; not for git)
dist/

# Doc / code bundles for partners (zip / tar archives produced on
# demand by `scripts/build_partner_pack.sh` to ship selected docs +
# reference sources via messenger; the canonical source lives under
# docs/ and crates/). Patterns are anchored to the repo root so any
# future top-level `<topic>_for_<recipient>_*.{zip,tar.gz,sha256}` is
# auto-ignored.
/*_for_*.zip
/*_for_*.tar.gz
/*_for_*.sha256

# Local cargo-audit snapshot (regenerated on demand; CI runs `cargo audit`
# fresh via the security:rust:audit job — the file in the workspace root is
# a developer convenience artefact, not a checked-in dependency).
cargo.audit

# Generated verifier and deployment artifacts
contracts/DepositVerifier.*
deployment_addresses.json
contracts/ethereum/deployment_real.json
deposit-prover/deposit_proof_output.json

# R15 / M2 bridge-evm-aggregator spike (standalone workspace, lock + target +
# regenerated KZG SRS + generated Yul/.bin artefacts; only the source tree
# under src/ + tests/ is committed).
crates/bridge-evm-aggregator/Cargo.lock
crates/bridge-evm-aggregator/target/
crates/bridge-evm-aggregator/params/
crates/bridge-evm-aggregator/out/

# Local-only scratch / backup artefacts (editor backups, ad-hoc patches,
# generated binaries, and not-for-commit experiments). Only USER_GUIDE.md and
# SUMMARY.md are intended to be committed from this batch.
FIX_TASK_FOR_AGENT.md.bak.*
acki-nacki_deposit-rlc-e2e.patch
deposit-prover/Cargo.lock.pse-backup
deposit-prover/Cargo.toml.bak_*
deposit-prover/Cargo.toml.pse-backup
deposit-prover/deposit_public_inputs.bin
deposit-prover/deposit_eth_circuit_params.json
deposit-prover/src/bin/an_rlc_verify.rs
docs/**/Acki_Nacki_Bridge_User_Guide.pdf.bak.*
docs/**/USER_GUIDE.pdf
docs/**/USER_GUIDE.md.bak.*

# Partner handoff / outreach messages — local-only drafts, not for commit.
docs/partner_handoff_*.md

.temp/*

# Runtime state + debug artefacts emitted by the relayer / prover binaries.
# Never commit — the .stale_* variants are ad-hoc backups from crash-recovery
# sessions; the submissions/ and diag/ dirs are env-gated dumps for offline
# replay (BRIDGE_DUMP_SUBMISSIONS_DIR, BRIDGE_DIAG_INSTANCES_FILE); the top
# `proofs/` dir is halo2 proof output. Mirrors the existing
# `crates/bridge-snark-utils/proofs/` rule.
/proofs/
crates/an-bridge-prover/relayer-state.json
crates/an-bridge-prover/relayer-state.json.stale_*
crates/an-bridge-prover/state.stale_*/
crates/an-bridge-prover/submissions/
crates/an-bridge-prover/diag/

# Local agent / venv / sold copies — never commit.
.serena/
.tools/
.venv-an-audit/
.venv*/

# eth-light-client-relayer runtime (daemon --state default) + prove-one dumps.
# Cargo.lock for this crate is tracked (see lock-file comment above).
eth-lc-relayer-state.json
eth-lc-relayer-state.json.lock
eth-lc-relayer-state.json.tmp
**/eth-lc-relayer-state.json*
crates/eth-light-client-relayer/bundle/
crates/eth-light-client-relayer/*.bin

# eth-light-client-prover: Hermez SRS downloads + example emit dirs.
# (repo-root `target/` and `out/` already cover cargo/build output.)
# Cargo.lock is tracked — same VK-reproducibility reason as deposit-prover.
eth-light-client-prover/data/
eth-light-client-prover/out/
eth-light-client-prover/*.srs
eth-light-client-prover/shard_snark/
eth-light-client-prover/rotate_tree/
