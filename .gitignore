contracts/ethereum/Halo2Verifier.yul
contracts/ethereum/verifier_bytecode.bin
contracts/ethereum/verifier_bytecode.hex
params/withdrawal_pk.bin
contracts/ethereum/test/test_proof.json

# Temporary proof files generated during testing
contracts/ethereum/proof_temp*.txt

# E2E test data (generated during test runs)
e2e_test_data/
e2e_attack_test_data/
*.e2e.json

# ZK proof generation artifacts
poseidon-proof/data/*
# Exception: test fixture files needed by Solidity tests in CI
