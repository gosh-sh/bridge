# Rust
target/
**/*.rs.bk
*.pdb
.cargo/*
!.cargo/audit.toml

# Cargo lock files: track the workspace-root Cargo.lock (CI's setup:rust runs
# `cargo fetch --locked` and `Dockerfile` copies it), but ignore lock files
# inside the workspace-excluded sub-projects, which each have their own
# independent dep tree.
deposit-prover/Cargo.lock
poseidon-proof/Cargo.lock
crates/bridge-prover-orchestrator/Cargo.lock
crates/bridge-relayer-daemon/Cargo.lock

# Foundry / Solidity
contracts/ethereum/out/
contracts/ethereum/cache/
contracts/ethereum/broadcast/
contracts/ethereum/lib/

# Environment variables and secrets
.env
.env.local
.env.*.local
.secrets

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Bridge prover orchestrator generated artifacts (Phase 1.A+):
# - SRS, VKs, PKs, and per-circuit base-circuit configs are produced by
#   `cargo test` runs. PKs are multi-GB. Do not commit.
crates/bridge-prover-orchestrator/params/*.srs
crates/bridge-prover-orchestrator/params/*_pk.bin
crates/bridge-prover-orchestrator/params/*_vk.bin
crates/bridge-prover-orchestrator/params/*_config_params.json
crates/bridge-prover-orchestrator/target/

# Phase 3: per-circuit proof artefacts (regenerated on demand by
# `cargo run --bin export-fallback-proof`).
crates/bridge-prover-orchestrator/proofs/

# Phase 3: per-circuit gnark-wrapper outputs. Only the .go / go.mod / go.sum
# source code is checked in; the trusted-setup keys, R1CS, and built binaries
# are regenerated locally by `gnark-wrappers/circuit-1b/circuit-1b setup`.
crates/bridge-prover-orchestrator/gnark-wrappers/*/circuit-1a
crates/bridge-prover-orchestrator/gnark-wrappers/*/circuit-1b
crates/bridge-prover-orchestrator/gnark-wrappers/*/circuit-2
crates/bridge-prover-orchestrator/gnark-wrappers/*/circuit-3
crates/bridge-prover-orchestrator/gnark-wrappers/*/circuit-4
crates/bridge-prover-orchestrator/gnark-wrappers/*/proving.key
crates/bridge-prover-orchestrator/gnark-wrappers/*/verification.key
crates/bridge-prover-orchestrator/gnark-wrappers/*/circuit.r1cs
crates/bridge-prover-orchestrator/gnark-wrappers/*/Groth16Verifier.sol
crates/bridge-prover-orchestrator/gnark-wrappers/*/groth16_proof.hex
crates/bridge-prover-orchestrator/gnark-wrappers/*/groth16_public_inputs.hex
crates/bridge-prover-orchestrator/gnark-wrappers/*/groth16_output.json
logs/

# Coverage
coverage/
*.profraw
*.profdata
lcov.info
cobertura.xml

# Test artifacts
test-results/
*.junit.xml

# Documentation build
target/doc/
contracts/ethereum/docs/book/

# Temporary files
tmp/
temp/
*.tmp

# OS specific
Thumbs.db
.DS_Store

# Node (if used for tooling)
node_modules/
package-lock.json
yarn.lock

# Build artifacts
*.so
*.dylib
*.dll
*.a
*.lib

# Data directories (deposit-prover/data/ contains large generated artifacts)
deposit-prover/data/
db/

# Keys and secrets (NEVER commit these!)
*.key
*.pem
keystore/
secrets/

# Generated verifier files (can be regenerated with `make generate-verifier`)
contracts/ethereum/Halo2Verifier.yul
contracts/ethereum/verifier_bytecode.bin
contracts/ethereum/verifier_bytecode.hex
params/withdrawal_pk.bin
contracts/ethereum/test/test_proof.json

# Temporary proof files generated during testing
contracts/ethereum/proof_temp*.txt

# E2E test data (generated during test runs)
e2e_test_data/
e2e_attack_test_data/
*.e2e.json

# ZK proof generation artifacts
poseidon-proof/data/*
# Exception: test fixture files needed by Solidity tests in CI
!poseidon-proof/data/evm_calldata.bin
!poseidon-proof/data/keccak_evm_calldata.bin
!poseidon-proof/data/keccak_verifier_deployment.bin
deposit-prover/params/
*.pk
*.snark
*.bkp

# KZG parameters (downloaded from trusted setup, not stored in git)
deposit-prover/data/*.srs

# AN→ETH gnark wrapper build artifacts (per-circuit, under bridge-prover-orchestrator)
# The deposit-prover/gnark-wrapper/ tree was retired in Phase 4.3 (2026-05-17).
crates/bridge-prover-orchestrator/gnark-wrappers/circuit-*/circuit.r1cs
crates/bridge-prover-orchestrator/gnark-wrappers/circuit-*/proving.key
crates/bridge-prover-orchestrator/gnark-wrappers/circuit-*/verification.key
crates/bridge-prover-orchestrator/gnark-wrappers/circuit-*/groth16_proof.hex
crates/bridge-prover-orchestrator/gnark-wrappers/circuit-*/groth16_output.json
crates/bridge-prover-orchestrator/gnark-wrappers/circuit-1a/circuit-1a
crates/bridge-prover-orchestrator/gnark-wrappers/circuit-1b/circuit-1b
crates/bridge-prover-orchestrator/gnark-wrappers/circuit-2/circuit-2

# Prompt files
*.prompt
!intergation.prompt

# Build artifacts
cache/
out/

# Generated verifier and deployment artifacts
contracts/DepositVerifier.*
deployment_addresses.json
contracts/ethereum/deployment_real.json
deposit-prover/deposit_proof_output.json
