 /// @notice Keccak-256 over a byte string (Ethereum `keccak256`) and the
 ///         parentHash extractor for an execution block-header RLP list.
 ///         TVM has no keccak builtin (`tvm.hash` is SHA-256 of a cell).
-///         Vectors: keccak256("") = c5d24601…d85a470, keccak256("abc") =
-///         4e03657a…2d6c45 (same as the relayer's tiny-keccak tests).
+///
+///         Verified by executing it, in tvm-debugger 3.0.6 against a
+///         wrapper contract, on 2026-09-13: keccak256("") =
+///         c5d24601…d85a470, keccak256("abc") = 4e03657a…2d6c45, and the
+///         real 642-byte Sepolia header of block 11683168 hashes to its own
+///         block hash 6b83c33d…122f83. Until then the vectors in this
+///         comment had only ever been checked by tiny-keccak in Rust, and
+///         the library threw exit 50 on the first `bc[i] = …` for every
+///         input — see the three sold notes below.
+///
+///         It computing correctly does not make it usable: one permutation
+///         is 12.93M gas against a 10M per-transaction limit, so hashing
+///         even the empty string exceeds a transaction. The wall is
+///         recorded on `submitAncestry` in EthBeaconLightClient.sol.
 library EthKeccak {
+    /// @dev All-ones over 64 bits. Stands in for `~` and for the top-bit
+    ///      truncation a fixed-width rotate needs, both of which sold
+    ///      range-checks rather than wrapping.
+    uint256 constant MASK64 = 0xFFFFFFFFFFFFFFFF;
+
     function hash(bytes data) internal pure returns (uint256) {
         uint64[] st;
         uint i;
@@ -91,16 +108,24 @@ library EthKeccak {
             uint64 lane = st[i];
             for (j = 0; j < 8; j++) {
                 // Lane is little-endian; hash byte 0 is the uint256 MSB.
-                out = (out << 8) | uint256(uint8(lane >> uint64(8 * j)));
+                // Masked before narrowing: `uint8()` of a shifted lane whose
+                // high bytes are still set is a range-check failure in sold,
+                // not a truncation.
+                out = (out << 8) | ((uint256(lane) >> (8 * j)) & 0xFF);
             }
         }
     }
 
+    /// @dev Rotation is done in `uint256` and masked back. `x << n` on a
+    ///      `uint64` is range-checked by sold, so the plain form throws exit 4
+    ///      (integer overflow) the moment a rotation drops a set bit off the
+    ///      top — which is every round.
     function _rotl(uint64 x, uint8 n) private pure returns (uint64) {
