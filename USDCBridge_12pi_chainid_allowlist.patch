From 993af815484d43e8432cf89a473669ab72f9d88a Mon Sep 17 00:00:00 2001
From: Sergey Egorov <sergey.egorov@pruvendo.com>
Date: Tue, 4 Aug 2026 15:36:25 +0300
Subject: [PATCH 5/6] exchange: per-chain mint cap as a damage bound
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Every other guard on the deposit path tries to make forgery impossible: the
proof, the source allowlist, the dApp check, the canonical-chain anchor set. None
of them bounds what a forgery is worth if one link turns out to be wrong anyway —
a compromised anchor writer, an opcode bug, a circuit gap not yet found. An
unbounded mint against a chain whose bridge holds a few thousand dollars is the
kind of asymmetry worth removing cheaply.

`setMintCap(chainId, cap)`, 0 = unlimited, enforced in `finalizeDeposit` and
tallied in `confirmDeposit`. Split across the two on purpose:

- checking before the voucher deploy keeps an over-cap deposit retryable once the
  cap is raised, where checking in `confirmDeposit` would consume the voucher and
  strand that deposit permanently;
- tallying only where a mint actually lands keeps replays from eating headroom.

The consequence is that N in-flight deposits can overshoot the cap by their
combined amount. Documented at the call site: this is a bound on damage, not an
exact invariant, and should not be read as one.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 contracts/exchange/USDCBridge.sol       | 48 ++++++++++++++++++++++++-
 contracts/exchange/modifiers/errors.sol |  1 +
 2 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/contracts/exchange/USDCBridge.sol b/contracts/exchange/USDCBridge.sol
index f7f80f43b..186d34bcd 100644
--- a/contracts/exchange/USDCBridge.sol
+++ b/contracts/exchange/USDCBridge.sol
@@ -37,7 +37,7 @@ interface IShellAccumulator {
 ///
 ///         Deployed at fixed address in zerostate.
 contract USDCBridge is USDCBridgeModifiers, ISubscriber {
-    // 1.2.0 — `srcChainId` is part of the deposit identity.
+    // 1.2.0 — `srcChainId` is part of the deposit identity; per-chain mint cap.
     string constant version = "1.2.0";
 
     event UsdcMigrated(address from, uint128 value);
@@ -136,6 +136,14 @@ contract USDCBridge is USDCBridgeModifiers, ISubscriber {
     // must be re-populated after a code upgrade.
     mapping(uint256 => mapping(uint256 => bool)) _acceptedBlockHash;
 
+    // Per-chain mint ceiling in ECC units: chainId → cap, 0 = unlimited.
+    // Orthogonal to every other guard here. Those all try to make forgery
+    // impossible; this one bounds what a forgery is worth if some link in the
+    // chain (a compromised anchor writer, an opcode bug, a circuit gap we have
+    // not found) turns out to be wrong anyway.
+    mapping(uint256 => uint128) _mintCapByChain;
+    mapping(uint256 => uint128) _mintedByChain;
+
     // ZK verifying key (VkBlob) for the FINAL ETH-deposit circuit — chain-binding
     // v2: 12 public inputs (chainId at instance #4). Hermez SRS (k=18), RLC circuit
     // shape num_advice_per_phase=[17,13]. Source:
@@ -439,6 +447,16 @@ contract USDCBridge is USDCBridgeModifiers, ISubscriber {
             _acceptedBlockHash[f.chainId][_parseBlockHash(publicInputs)],
             ERR_UNKNOWN_BLOCK
         );
+        // (d) Per-chain damage bound. Checked here, before the voucher is
+        //     deployed, so a deposit that overshoots the cap reverts and stays
+        //     retryable once the cap is raised; checking it in `confirmDeposit`
+        //     instead would burn the voucher and strand that deposit forever.
+        //     The flip side is that the tally only moves when a mint actually
+        //     lands, so N concurrently in-flight deposits can overshoot by up to
+        //     their combined amount. That is acceptable for a bound on damage;
+        //     it is not an exact invariant and should not be read as one.
+        uint128 cap = _mintCapByChain[f.chainId];
+        require(cap == 0 || _mintedByChain[f.chainId] + f.amount <= cap, ERR_MINT_CAP_EXCEEDED);
 
         ensureBalance();
 
