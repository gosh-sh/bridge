From 7992ce2674b5cdd778f31402cd36112309c9bcb8 Mon Sep 17 00:00:00 2001
From: Sergey Egorov <sergey.egorov@pruvendo.com>
Date: Tue, 4 Aug 2026 15:11:52 +0300
Subject: [PATCH 3/6] exchange: gate finalizeDeposit on a canonical-chain
 anchor set
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The deposit proof shows the event sits in a well-formed block whose header
hashes to public inputs #9/#10 — it cannot show that block is on the canonical
chain of the source `chainId`. An attacker mines a private block containing a
deposit event that never happened and the proof verifies, so `finalizeDeposit`
was mintable by anyone able to run the (public) prover. The contract was not
even reading the block-hash instances.

Canonicality is a consensus fact no receipt-inclusion circuit can establish, so
assert it from outside the proof: `_acceptedBlockHash[chainId][blockHash]` must
hold, mirroring the shape the ETH side already uses in the opposite direction
(`AckiNackiBridge._knownAnchors` consulted by `withdrawByProof`). The owner key
populates it for now and is therefore the documented trust root for source-chain
canonicality; that is deliberately a seam — swapping in an M-of-N attester set,
or eventually an Ethereum light client, adds a writer and leaves
`finalizeDeposit` untouched.

Parsed after `tvm.accept()` so the pre-accept gas profile of the live path does
not move. Fail-closed, and like `_expectedBridgeFr` not carried through
`onCodeUpgrade` — operators must admit the deposit's block before finalizing it.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 contracts/exchange/USDCBridge.sol       | 107 +++++++++++++++++++++++-
 contracts/exchange/modifiers/errors.sol |   1 +
 2 files changed, 106 insertions(+), 2 deletions(-)

diff --git a/contracts/exchange/USDCBridge.sol b/contracts/exchange/USDCBridge.sol
index 985a9d573..7813b6cc9 100644
--- a/contracts/exchange/USDCBridge.sol
+++ b/contracts/exchange/USDCBridge.sol
@@ -109,6 +109,31 @@ contract USDCBridge is USDCBridgeModifiers, ISubscriber {
     // from being cross-relayed here. Owner-configured via `setExpectedAnDappId`.
     uint256 _expectedAnDappId;
 
+    // Canonical-chain anchor set: chainId → source block hash → accepted.
+    //
+    // The deposit proof establishes that the event sits in a block whose header
+    // hashes to public inputs #9/#10, and that the header is well-formed RLP —
+    // but NOT that this block is on the canonical chain of `chainId`. That is a
+    // fact about Ethereum consensus, and no receipt-inclusion circuit can
+    // establish it: an attacker mines a private block containing a deposit event
+    // that never happened, and the proof verifies. Without this gate the whole
+    // ETH→AN direction is forgeable by anyone who can run the (public) prover.
+    //
+    // So canonicality is asserted from OUTSIDE the proof, and this mapping is
+    // where that assertion lands — the same shape the ETH side already uses for
+    // the opposite direction (`AckiNackiBridge._knownAnchors`, consulted by
+    // `withdrawByProof`). Today the owner populates it (`setAcceptedBlockHash`),
+    // i.e. the owner key is the documented trust root for source-chain
+    // canonicality. That is deliberately a seam, not a design: replacing the
+    // owner with an M-of-N attester set — or eventually an Ethereum light client
+    // — means adding a writer for this mapping and touching nothing in
+    // `finalizeDeposit`.
+    //
+    // Fail-closed: an unset entry rejects the deposit. Like `_expectedBridgeFr`
+    // this is NOT threaded through the `onCodeUpgrade` migration cell, so it
+    // must be re-populated after a code upgrade.
+    mapping(uint256 => mapping(uint256 => bool)) _acceptedBlockHash;
+
     // ZK verifying key (VkBlob) for the FINAL ETH-deposit circuit — chain-binding
     // v2: 12 public inputs (chainId at instance #4). Hermez SRS (k=18), RLC circuit
     // shape num_advice_per_phase=[17,13]. Source:
@@ -400,6 +425,18 @@ contract USDCBridge is USDCBridgeModifiers, ISubscriber {
         // (b) Cross-dApp replay guard: the proof-bound dappId must match this
         //     deployment's AN dApp id.
         require(f.dappId == _expectedAnDappId, ERR_WRONG_DAPP);
+        // (c) Canonical-chain gate: the proof binds the event to a block whose
+        //     header hashes to instances #9/#10, but says nothing about that
+        //     block being on the canonical chain — a privately mined block
+        //     carrying a fabricated deposit event proves just as well. The hash
+        //     must therefore appear in the anchor set, which is asserted from
+        //     outside the proof (see `_acceptedBlockHash`). Parsed here rather
+        //     than in the pre-accept path so the external-message gas budget
+        //     that the live path already fits stays untouched.
+        require(
+            _acceptedBlockHash[f.chainId][_parseBlockHash(publicInputs)],
+            ERR_UNKNOWN_BLOCK
+        );
 
         ensureBalance();
 
@@ -513,6 +550,39 @@ contract USDCBridge is USDCBridgeModifiers, ISubscriber {
         _expectedAnDappId = dappId;
     }
 
+    /// @notice Marks a source-chain block hash as canonical, permitting deposit
+    ///         proofs anchored to it. Must be called for the deposit's block
+    ///         before `finalizeDeposit` will accept it (fail-closed).
+    ///
+    ///         The caller is asserting a fact the proof cannot: that this block
+    ///         is on the canonical chain of `chainId`. Two obligations come with
+    ///         that, and neither is enforceable here — they belong to whoever
+    ///         holds the key:
+    ///           * wait for enough confirmations that the block cannot be
+    ///             reorged out. An honest attestation of a reorged block loses
+    ///             funds exactly like a dishonest one.
+    ///           * read the hash from a source independent of the party that
+    ///             produced the proof, or the gate is decorative.
+    ///
+    ///         Accepts a hash rather than a header so that swapping this writer
+    ///         for an M-of-N attester set (or a light client) later needs no
+    ///         change to `finalizeDeposit`.
+    /// @param chainId   — EIP-155 chain id of the source L1/L2.
+    /// @param blockHash — the block's 256-bit hash, as the circuit binds it into
+    ///                    public inputs #9/#10 (`hi << 128 | lo`).
+    /// @param accepted  — true to admit, false to retract (e.g. on discovering
+    ///                    the block was reorged out before any deposit landed).
+    function setAcceptedBlockHash(uint256 chainId, uint256 blockHash, bool accepted)
+        public onlyOwnerPubkey(_ownerPubkey) accept
+    {
+        ensureBalance();
+        if (accepted) {
+            _acceptedBlockHash[chainId][blockHash] = true;
+        } else {
+            delete _acceptedBlockHash[chainId][blockHash];
+        }
+    }
+
     // ========================================================
     // On-chain code upgrade (owner only)
     // ========================================================
@@ -623,6 +693,13 @@ contract USDCBridge is USDCBridgeModifiers, ISubscriber {
         return _expectedAnDappId;
     }
 
+    /// @notice Whether a source-chain block hash has been admitted as canonical,
+    ///         i.e. whether a deposit proof anchored to it can be finalized.
+    ///         False for every hash until the owner admits it.
+    function isAcceptedBlockHash(uint256 chainId, uint256 blockHash) external view returns (bool) {
+        return _acceptedBlockHash[chainId][blockHash];
+    }
+
     /// @notice Returns current nonces for double-spend protection.
     function getNonces() external view returns (uint64 mintNonce, uint64 mintAccumulatorNonce) {
         return (_mintNonce, _mintAccumulatorNonce);
@@ -642,8 +719,10 @@ contract USDCBridge is USDCBridgeModifiers, ISubscriber {
     ///      here is proof-bound). Layout = 12 × 32-byte LE Fr; offsets per the
     ///      final ETH-deposit circuit (chain-binding v2): 0=deposit_id, 1=sender,
     ///      2=amount, 3=contract, 4=chainId, 5..6=dapp_id(hi..lo),
-    ///      7..8=an_account(hi..lo), 9..10=block hash, 11=promiseCommit (the last
-    ///      three ignored on the AN side). Only the first 9 Fr are needed.
+    ///      7..8=an_account(hi..lo), 9..10=block hash, 11=promiseCommit.
+    ///      Reads the first 9 only: `sender` is informational, the block hash is
+    ///      read separately by `_parseBlockHash` (post-accept) and
+    ///      `promiseCommit` is internal to the keccak coprocessor.
     function _parsePublicInputs(bytes publicInputs) private pure returns (DepositPI f) {
         TvmSlice s = publicInputs.toSlice();
         uint256[] fr;
@@ -667,4 +746,28 @@ contract USDCBridge is USDCBridgeModifiers, ISubscriber {
         f.dappId       = (fr[5] << 128) | fr[6];
         f.anAccount    = (fr[7] << 128) | fr[8];
     }
+
+    /// @dev Reassembles the proof-bound source block hash from public inputs
+    ///      #9/#10 — the circuit splits the 32-byte hash into two 16-byte halves
+    ///      (hi first), exactly as it does for `an_account`. Same little-endian
+    ///      Fr decoding as `_parsePublicInputs`; separate function because it is
+    ///      called after `tvm.accept()`, keeping the pre-accept cost of the live
+    ///      path unchanged.
+    function _parseBlockHash(bytes publicInputs) private pure returns (uint256) {
+        TvmSlice s = publicInputs.toSlice();
+        uint256 hi = 0;
+        uint256 lo = 0;
+        for (uint k = 0; k < 11; k++) {
+            for (uint i = 0; i < 32; i++) {
+                if (s.bits() < 8) { s = s.loadRef().toSlice(); }
+                uint256 b = uint256(uint8(s.loadUint(8)));   // little-endian
+                if (k == 9) {
+                    hi |= b << (8 * i);
+                } else if (k == 10) {
+                    lo |= b << (8 * i);
+                }
+            }
+        }
+        return (hi << 128) | lo;
+    }
 }
diff --git a/contracts/exchange/modifiers/errors.sol b/contracts/exchange/modifiers/errors.sol
index 2d5dfcb6b..7ba1a6aa3 100644
--- a/contracts/exchange/modifiers/errors.sol
+++ b/contracts/exchange/modifiers/errors.sol
@@ -15,4 +15,5 @@ abstract contract USDCBridgeErrors {
     uint16 constant ERR_UNSUPPORTED_TOKEN = 221;
     uint16 constant ERR_UNKNOWN_SOURCE = 222;
     uint16 constant ERR_WRONG_DAPP = 223;
+    uint16 constant ERR_UNKNOWN_BLOCK = 224;
 }
-- 
