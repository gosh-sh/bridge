 contracts/exchange/USDCBridge.sol       | 293 +++++++++++++++---------
 contracts/exchange/modifiers/errors.sol |   2 +
 2 files changed, 187 insertions(+), 108 deletions(-)

diff --git a/contracts/exchange/USDCBridge.sol b/contracts/exchange/USDCBridge.sol
index f8dd75f1f..4ec25efed 100644
