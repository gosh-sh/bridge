# .env.shellnet — DeployShellnetE2EBridge.s.sol input for Sepolia
# Generated 2026-08-02 by compute_bridge_anchors --at-head against shellnet.
#
# CONSUMED BY:
#   forge script script/DeployShellnetE2EBridge.s.sol:DeployShellnetE2EBridge \
#     --rpc-url $SEPOLIA_RPC_URL --broadcast --slow
#
# SAFETY:
#   * .env.shellnet IS tracked in git — it carries the shared shellnet
#     deployer burner + genesis anchors needed to reproduce a deploy. Only
#     personal editor backups (`.env.shellnet.*.bak*`) are gitignored.
#   * PRIVATE_KEY is a Sepolia-only burner. Do NOT reuse this key for
#     anything of value on any other network.
#   * START_PAUSED=true — bridge is deployed but user entrypoints revert
#     until owner calls `unpause()` post-Phase-4 sanity checks.

# --- deployer / RPC -----------------------------------------------------------
# Public shared-onboarding burner — key intentionally in-repo (Sepolia only).
# Address: 0xb586356D52eAee055Ca569Ff412DFeFFc5bB2307
PRIVATE_KEY=0xb27eec55faeb770f38f86130f4ec9abf901987a68251aade12331fe77f4ecd87

# Public no-key Sepolia endpoints (rotate if throttled).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Alt:  https://sepolia.drpc.org
# Alt:  https://rpc.sepolia.org

# --- genesis anchors (from compute_bridge_anchors --at-head, shellnet) --------
# seed key-block seq_no = 8768512 (bundle boundary 1024) — Deploy #8, 2026-08-17
# seed block_height     = 8768512 (chain head was 8768587 at derivation time,
#                         only +75 lookahead → daemon can catch bundle 1 in
#                         first ~5 min and burn covered by bundle 1)
# BK set size           = 5 (rotation OFF on shellnet — same commitment as
#                         prior Deploys #6 and #7)
# Prior Deploy #7 (0x822E98…2f90) at seqno 8759296 abandoned because burn was
# fired mid-flight → covering bundle was 8 bundles ahead of daemon anchor →
# 90 min wait unacceptable. Deploy #8 with tight lookahead lets us fire burn
# during bundle 1 processing window (12 min total vs 90 min).
GENESIS_BK_SET_COMMITMENT=0x08eb0a1892e4f75a8b5c8cff69322f95bf0437c371903998c9365fbe293ca71c
GENESIS_PREV_MAX_LEVEL_LAYER_HASH=0x2d57d3290fbd14e8296240d646ca55de98f375169dea93079061a3abab88dfe1
# Must equal BRIDGE_BOOTSTRAP_SEQNO in the daemon's .env.shellnet — the daemon
# bakes this as `last_seen_block_seqno` into instance[15] of every Circuit 1a/1b
# proof. Constructor seeds `storedLastSeenBlockSeqNo` with this value so the
# very first verifyBlock's `_readInstance(proof, 15) == storedLastSeenBlockSeqNo`
# check passes. Missing this on Deploy #3 caused AttestationProofRejected()
# on every submit (see bridge-deployer.txt for Deploy #4 rationale).
GENESIS_LAST_SEEN_BLOCK_SEQNO=9052160

# --- deploy-time toggles ------------------------------------------------------
# Bridge deployed paused; unpause via `cast send $BRIDGE "unpause()"` after
# Phase 4 sanity checks (verifier addresses + paused() + genesis anchors).
START_PAUSED=true

# Circuit 4 (withdrawByProof) wiring is mandatory since NB-Q8 (commit 7a645e5)
# on any chain other than local anvil (chainid 31337). The C4 `.bin` is
# committed at verifiers/BridgeWithdrawalAggregatorVerifier.bin.
#
# WITHDRAW_ACC_FR is the canonical shellnet USDCBridge account_id (32 bytes of
# 0x1a) reinterpreted as a BN254 Fr numeric. Symmetric bytes → LE and BE
# encodings coincide and are both below the Fr modulus, so no reduction. The
# Circuit 4 proof produces instance[7]=acc_fr = bytes_to_fr(account_id) from
# the emitter cell; the constructor stores this value so the withdrawByProof
# equality check passes. Verified 2026-08-17 against
# docs/deposit_vk_reproducibility.md:51 and python/helper/bridge_e2e.py:46.
WIRE_WITHDRAW_BY_PROOF=true
WITHDRAW_ACC_FR=0x1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a
