# .env.shellnet.l2 — DeployShellnetE2EBridge.s.sol input for Sepolia (L2 wiring)
# Generated 2026-08-18 by compute_bridge_anchors --level 2 --at-head against shellnet.
#
# CONSUMED BY:
#   forge script script/DeployShellnetE2EBridge.s.sol:DeployShellnetE2EBridge \
#     --rpc-url $SEPOLIA_RPC_URL --broadcast --slow
#
# LEVEL NOTE:
#   Contract itself is level-opaque — it stores a single scalar
#   `storedPrevMaxLevelLayerHash` and only compares equality. The genesis
#   scalar below IS the layer-2 fold, matching what the daemon will emit
#   as instance[0]/[1] in its first L2 bundle proof.
#
# SAFETY: burner key. Tracked in git — same posture as .env.shellnet (only
# personal editor backups `.env.shellnet.*.bak*` are ignored).

# --- deployer / RPC -----------------------------------------------------------
# Public shared-onboarding burner (Sepolia only).
# Address: 0xb586356D52eAee055Ca569Ff412DFeFFc5bB2307
PRIVATE_KEY=0xb27eec55faeb770f38f86130f4ec9abf901987a68251aade12331fe77f4ecd87

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- genesis anchors (L2, from compute_bridge_anchors --level 2 --at-head) ----
# anchor level = 2, bundle stride = 16384 (W² for W=128)
# seed key-block seq_no = 9175040 (bundle boundary 16384 × 560)
# chain head at derivation ≈ 9189211 → ~14171 blocks (~78 min) lookahead
# BK set size = 5 (rotation OFF; same commitment as prior deploys)
GENESIS_BK_SET_COMMITMENT=0x08eb0a1892e4f75a8b5c8cff69322f95bf0437c371903998c9365fbe293ca71c
GENESIS_PREV_MAX_LEVEL_LAYER_HASH=0x21f5cc5f6df534d10f9c5d7a9dbc357d741f554432dbfa8c5f20498a5c0bf493
# Constructor stamps `storedLastSeenBlockSeqNo` with this value. Daemon's
# BRIDGE_BOOTSTRAP_SEQNO in .env.shellnet.l2 must match, or the first
# verifyBlock reverts with PrevAnchorMismatch.
GENESIS_LAST_SEEN_BLOCK_SEQNO=9175040

# --- deploy-time toggles ------------------------------------------------------
# Deployed paused; unpause after Phase 4 sanity checks.
START_PAUSED=true

# Circuit 4 wiring mandatory off anvil (NB-Q8).
WIRE_WITHDRAW_BY_PROOF=true
WITHDRAW_ACC_FR=0x1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a
