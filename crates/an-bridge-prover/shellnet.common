# shellnet.common — shared Sepolia-E2E env sourced by both L1_config/env
# and L2_config/env. Contains only settings that are identical between L1
# and L2 modes. Per-mode files layer their own vars on top and set
# `BRIDGE_CONFIG_DIR`, which drives `bridge-prover-lib::paths`.
#
# NOT sourced directly by tools. Consumed via:
#   cd crates/an-bridge-prover
#   set -a && source L1_config/env && set +a    # or L2_config/env
#   cargo run --release -p bridge-relayer-daemon --bin relayer -- daemon-live
#
# SAFETY:
#   * shellnet.common IS tracked in git — it carries the shared shellnet burner
#     that every operator needs to reproduce a run. Only personal editor
#     backups (see bridge/.gitignore `.env.shellnet.*.bak*`) are ignored.
#   * RELAYER_PRIVATE_KEY is a Sepolia-only burner. Do NOT reuse this key
#     for anything of value on any other network.

# --- Ethereum side (Sepolia) --------------------------------------------------
# Owner is the deployer key from contracts/ethereum/.env.shellnet.* — NOT the
# relayer. verifyBlock and withdrawByProof are permissionless so the ownership
# split is fine for the E2E. The relayer key below has ~5.14 ETH.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Address is 0x841709B6842233d8474aeA1d773e8d0F7c7c0B9f.
RELAYER_PRIVATE_KEY=0xd6163ee202de592a73fc026501719a9b8761cbbdfb5868edd91da0b8718b4a2c

# --- Acki Nacki side (shellnet) -----------------------------------------------
BRIDGE_GQL_ENDPOINT=https://shellnet.ackinacki.org/graphql
BRIDGE_BK_SET_CONFIG=./bk_set.shellnet.json

# --- local dirs ---------------------------------------------------------------
# `params/` holds ~17 GB of pre-built SRS + per-circuit vk/pk files.
# Do NOT wipe — keygen would re-burn ~7 min.
BRIDGE_PARAMS_DIR=./params

# --- C1/C2 R15 SHPLONK aggregation (mandatory) --------------------------------
# `daemon-live` unconditionally wraps LiveBlockSource with AggregatedBlockSource
# because the on-chain AckiNackiBridge verifier only accepts aggregated
# calldata (raw halo2 bytes revert with AttestationProofRejected()). Both
# vars are required — the daemon refuses to start without them.
BRIDGE_AGGREGATOR_DIR=../bridge-evm-aggregator
BRIDGE_VERIFIERS_DIR=../../contracts/ethereum/verifiers

# --- backoff (defaults are already sane; overridable) -------------------------
# --backoff-initial-secs 2 --backoff-max-secs 60 --backoff-multiplier 2
