# shellnet.common — shared Sepolia-E2E env sourced by both L1_config/env
# and L2_config/env. Contains only settings that are identical between L1
# and L2 modes. Per-mode files layer their own vars on top and set
# `BRIDGE_CONFIG_DIR`, which drives `bridge-prover-lib::paths`.
#
# NOT sourced directly by tools. Consumed via:
#   cd crates/bridge-prover-libraries
#   set -a && source L1_config/env && set +a    # or L2_config/env
#   cargo run --release -p bridge-relayer-daemon --bin relayer -- daemon-live
#
# SAFETY:
#   * shellnet.common IS tracked in git, and carries no key. API keys and the
#     relayer's private key go in the untracked .env next to it (matched by
#     .gitignore). Personal editor backups (`.env.shellnet.*.bak*`) are
#     ignored too.

# --- Ethereum side (Sepolia) --------------------------------------------------
# RELAYER_PRIVATE_KEY comes from .env: a Sepolia EOA of your own, used for
# BOTH the deploy (owner) role and the relayer role (`verifyBlock` and
# `withdrawByProof` are permissionless). Never share it: the relayer replaces
# whatever transaction waits at its account's next nonce, so two daemons on
# one key replace each other's transactions. Do NOT reuse it for anything of
# value on any other network. For the deploy path
# (`scripts/deploy_bridge_bundle.sh`) re-export it as `PRIVATE_KEY` — e.g.
# `PRIVATE_KEY=$RELAYER_PRIVATE_KEY LEVEL=1 ./scripts/deploy_bridge_bundle.sh`.
# RPC_URL is the primary Ethereum endpoint; the relayer falls back to the
# RPC_FAILOVER_URLS entries in order when it fails
# (crates/bridge-relayer-daemon/src/eth_rpc.rs). Together they must serve
# `eth_getLogs` back to the bridge's oldest held anchor (`daemon-live`
# rebuilds the window heights from `LayerAnchorAppended` at every start) and
# accept the relayer's transactions. Measured 2026-10-19:
#   * Infura (key): eth_getLogs up to 10 000 blocks, full history, archive.
#   * Alchemy free tier (key): eth_getLogs up to 10 blocks only.
#   * EF DevOps: up to 10 000 blocks with history; unstable.
#   * publicnode: keeps only the newest ~10 000 blocks of logs.
#   * Tenderly's public gateway: history and wide spans, but answered
#     applyBkSetUpdate sends with -32005 (rate limit), even one at a time.
# API keys go in the untracked .env next to this file (matched by .gitignore):
#   ALCHEMY_API_KEY=...
#   INFURA_API_KEY=...
#   RELAYER_PRIVATE_KEY=0x...
# NEVER put a key in this file: it is tracked, and .gitleaks.toml does not
# scan it. An endpoint whose key is not set is left out; without
# INFURA_API_KEY the EF DevOps endpoint is the primary.
_shellnet_common_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$_shellnet_common_dir/.env" ]; then
  source "$_shellnet_common_dir/.env"
fi
RPC_URL=${INFURA_API_KEY:+https://sepolia.infura.io/v3/$INFURA_API_KEY}
RPC_URL=${RPC_URL:-https://rpc.sepolia.ethpandaops.io}
RPC_FAILOVER_URLS=${ALCHEMY_API_KEY:+https://eth-sepolia.g.alchemy.com/v2/$ALCHEMY_API_KEY,}https://rpc.sepolia.ethpandaops.io,https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co
if [ -z "${RELAYER_PRIVATE_KEY:-}" ]; then
  echo "shellnet.common: RELAYER_PRIVATE_KEY is not set; put the key of a Sepolia EOA of your own into $_shellnet_common_dir/.env" >&2
fi
unset _shellnet_common_dir
# Pace the startup LayerAnchorAppended scan for Infura's free tier: 500
# credits a second, 255 per eth_getLogs. Back to back, the scan drew HTTP 429
# for the next half minute, even on eth_chainId.
BRIDGE_GET_LOGS_PAUSE_MS=600

# --- Acki Nacki side (shellnet) -----------------------------------------------
BRIDGE_GQL_ENDPOINT=https://shellnet.ackinacki.org/graphql
# Optional for `relayer daemon-live`: comma-separated failover GraphQL URLs
# tried after BRIDGE_GQL_ENDPOINT exhausts its retries (see TECHNICAL_README).
# BRIDGE_GQL_FAILOVER_ENDPOINTS=
BRIDGE_BK_SET_CONFIG=./bk_set.shellnet.json

# --- local dirs ---------------------------------------------------------------
# `params/` holds ~17 GB of pre-built SRS + per-circuit vk/pk files.
# Do NOT wipe — keygen would re-burn ~7 min.
BRIDGE_PARAMS_DIR=./params

# --- C1/C2 R15 SHPLONK aggregation (mandatory) --------------------------------
# `daemon-live` unconditionally wraps LiveBlockSource with AggregatedBlockSource
# because the on-chain AckiNackiBridge verifier only accepts aggregated
# calldata (raw halo2 bytes revert with AttestationProofRejected()). Both
# vars are required — the daemon refuses to start without them, or with a
# path that is not an executable file. `BRIDGE_AGGREGATOR_DIR` is the cargo tree the
# `ackinacki-bridge` CLI builds its path from; the relayer takes the binary.
BRIDGE_AGGREGATOR_DIR=../bridge-evm-aggregator
BRIDGE_AGGREGATE_PROOF_BIN=../bridge-evm-aggregator/target/release/aggregate-proof
BRIDGE_VERIFIERS_DIR=../../contracts/ethereum/verifiers

# --- backoff (defaults are already sane; overridable) -------------------------
# --backoff-initial-secs 2 --backoff-max-secs 60 --backoff-multiplier 2
