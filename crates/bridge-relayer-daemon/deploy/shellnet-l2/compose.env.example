# Non-secret Docker Compose settings. Copy to `.env` beside compose.yaml.
RELAYER_IMAGE=gosh-bridge-relayer-l2:CHANGEME_GIT_SHA
BRIDGE_SOURCE_DIR=/opt/gosh/bridge
RELAYER_RELEASE_DIR=/opt/gosh/bridge/crates/an-bridge-prover/target/release
AGGREGATOR_RELEASE_DIR=/opt/gosh/bridge/crates/bridge-evm-aggregator/target/release
VERIFIER_BINS_DIR=/opt/gosh/bridge/contracts/ethereum/verifiers
FOUNDRY_BIN_DIR=/usr/local/bin
SOLC_BIN_DIR=/root/.local/share/svm/0.8.19
RELAYER_RUNTIME_ROOT=/var/lib/gosh-bridge-relayer
RELAYER_RUNTIME_ENV=/etc/gosh-bridge-relayer/shellnet-l2.env
EXPECTED_BRIDGE_COMMIT=CHANGEME_FULL_GIT_SHA
RELAYER_UID=998
RELAYER_GID=998
