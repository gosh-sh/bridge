# Secret-bearing inputs for one fresh shellnet -> Sepolia L2 bridge deploy.
# Copy outside the repository, install as root-only (0600), and replace every
# CHANGEME. Never source this file with shell xtrace enabled.

LEVEL=2
# Closed by default. Change only for the audited one-shot broadcast.
CONFIRM_NEW_BRIDGE_DEPLOY=NO
PRIVATE_KEY=CHANGEME_DEDICATED_SEPOLIA_PRIVATE_KEY
SEPOLIA_RPC_URL=CHANGEME_AUTHENTICATED_SEPOLIA_HTTPS_RPC
BRIDGE_GQL_ENDPOINT=https://shellnet.ackinacki.org/graphql
BRIDGE_BK_SET_CONFIG=./bk_set.shellnet.json

# Circuit 4 withdrawal identity. WITHDRAW_ACC_FR must be the authoritative AN
# bridge account field value; a placeholder permanently makes real withdrawal
# proofs unusable for this deployment.
WIRE_WITHDRAW_BY_PROOF=true
WITHDRAW_DAPP_FR=CHANGEME_DEPLOYED_VALUE
WITHDRAW_ACC_FR=CHANGEME_AUTHORITATIVE_AN_BRIDGE_ACCOUNT_FR
WITHDRAW_ALT_DST_CHAIN_ID=1
WITHDRAW_ALT_DST_HOST_CHAIN_ID=11155111
WITHDRAW_ALT_TOKEN_ID=3
