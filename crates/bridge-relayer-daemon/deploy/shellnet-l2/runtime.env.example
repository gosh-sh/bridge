# Secret-bearing shellnet -> Sepolia L2 runtime environment. Install outside
# the repository as root:<service-group> 0640. Never commit the filled file.

BRIDGE_REPO_DIR=/opt/gosh/bridge
EXPECTED_BRIDGE_COMMIT=CHANGEME_FULL_GIT_SHA
RELAYER_BINARY=/opt/gosh/bridge/crates/bridge-prover-libraries/target/release/relayer
EXPECTED_RELAYER_SHA256=CHANGEME_AFTER_TARGET_BUILD
RELAYER_STATE_PATH=/var/lib/gosh-bridge-relayer/L2_config/relayer-state.json

RPC_URL=CHANGEME_AUTHENTICATED_SEPOLIA_HTTPS_RPC
BRIDGE_ADDRESS=CHANGEME_FRESH_BRIDGE_ADDRESS
RELAYER_ADDRESS=CHANGEME_DEDICATED_SEPOLIA_EOA
RELAYER_PRIVATE_KEY=CHANGEME_DEDICATED_SEPOLIA_PRIVATE_KEY
MIN_RELAYER_BALANCE_WEI=20000000000000000
BRIDGE_GQL_ENDPOINT=https://shellnet.ackinacki.org/graphql

BRIDGE_CONFIG_DIR=/var/lib/gosh-bridge-relayer/L2_config
BRIDGE_STATE_DIR=/var/lib/gosh-bridge-relayer/L2_config/state
BRIDGE_PARAMS_DIR=/var/lib/gosh-bridge-relayer/params
PARAMS_SHA256SUMS=/var/lib/gosh-bridge-relayer/params/SHA256SUMS
PARAMS_MANIFEST_SHA256=CHANGEME_AFTER_PARAM_FINALIZATION
BRIDGE_PK_CACHE_DIR=/var/lib/gosh-bridge-relayer/params/pk_cache
BRIDGE_DUMP_SUBMISSIONS_DIR=/var/lib/gosh-bridge-relayer/submissions
BRIDGE_BK_SET_CONFIG=/opt/gosh/bridge/crates/bridge-prover-libraries/bk_set.shellnet.json
BRIDGE_BK_SET_EXPECTED_SHA256=c77e3d6de5e6ea8ee96c6902f1b6ecb011bba2d631e76fa546e44ee67173898f
EXPECTED_BK_SET_COMMITMENT=0x08eb0a1892e4f75a8b5c8cff69322f95bf0437c371903998c9365fbe293ca71c

EXPECTED_GENESIS_PREV_ANCHOR=CHANGEME_FROM_COMPUTE_BRIDGE_ANCHORS
EXPECTED_WITHDRAW_DAPP_FR=CHANGEME_DEPLOYED_VALUE
EXPECTED_WITHDRAW_ACC_FR=CHANGEME_DEPLOYED_VALUE
EXPECTED_WITHDRAW_ALT_DST_CHAIN_ID=1
EXPECTED_WITHDRAW_ALT_DST_HOST_CHAIN_ID=11155111
EXPECTED_WITHDRAW_ALT_TOKEN_ID=3
EXPECTED_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

BRIDGE_AGGREGATOR_DIR=/opt/gosh/bridge/crates/bridge-evm-aggregator
EXPECTED_AGGREGATE_PROOF_SHA256=CHANGEME_AFTER_TARGET_BUILD
BRIDGE_VERIFIERS_DIR=/opt/gosh/bridge/contracts/ethereum/verifiers
BRIDGE_ANCHOR_LEVEL=2
BRIDGE_BOOTSTRAP_SEQNO=CHANGEME_W2_ALIGNED_GENESIS_SEED
EXPECTED_EVM_CHAIN_ID=11155111

RUST_LOG=info,bridge_relayer_daemon=info,bridge_prover_lib=info
RUST_BACKTRACE=1
