# eth-lc-relayer, shellnet shadow (Sepolia beacon -> EthBeaconLightClient on shellnet).
# Copy to $ETH_LC_ROOT/config/eth-lc-relayer.env (mode 0600) and fill the
# addresses printed by deploy-contract.sh. No secrets belong here except the
# path to the key file.

# Beacon REST with light-client endpoints (finality_update, updates, genesis,
# config/spec). Lodestar (ChainSafe) and Nimbus public nodes serve them for
# Sepolia; publicnode does not serve `updates`.
BEACON_URL=https://lodestar-sepolia.chainsafe.io

# Prover checkout + Hermez SRS (k=19, sha256
# 9ebbbbfc3d4899435ef254c915c62f5aa94c539bde1cec52ca7d45679d2adf4a).
LIGHT_CLIENT_PROVER_DIR=/mnt/data/gosh-eth-lc-relayer/src/bridge/eth-light-client-prover
STEP_SRS_PATH=/mnt/data/gosh-eth-lc-relayer/srs/kzg_bn254_19.srs

# Acki Nacki shellnet.
AN_GRAPHQL_URL=https://shellnet.ackinacki.org/graphql
AN_KEYS_PATH=/mnt/data/gosh-eth-lc-relayer/config/eth-lc-owner.keys.json
AN_LC_ABI_PATH=/mnt/data/gosh-eth-lc-relayer/contracts/EthBeaconLightClient.abi.json
# <account_id>::<account_id> (self-rooted deploy), printed by deploy-contract.sh
AN_LIGHT_CLIENT=
# Sender identity for the relayer's tvm_client calls; same value as AN_LIGHT_CLIENT is fine
# (calls are external messages signed with AN_KEYS_PATH; the contract pays for itself).
AN_SENDER=

# Shadow mode: no USDCBridge wiring. Leave both empty. Setting AN_USDC_BRIDGE
# together with removing --no-flip-owner from the unit is the production flip,
# which is one-way.
AN_USDC_BRIDGE=
AN_USDC_ABI_PATH=

# Sepolia execution JSON-RPC, only needed for `submit-ancestry`.
# ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

RUST_LOG=info
