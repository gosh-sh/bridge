# Compose project settings for docker/compose.yaml. Copy next to the compose
# file as `.env` (or pass --env-file). No address, key or endpoint belongs
# here: those are in $BRIDGE_OPT/env/*.env, see env/*.env.example.

# Names the project (bridge-<net>) and nothing else.
BRIDGE_NET=shellnet

# Images: registry and tag. The tag is the short commit the images were built
# from (CI tags every push to main) or a release tag.
BRIDGE_REGISTRY=docker.gosh.sh
BRIDGE_IMAGE_TAG=CHANGEME_SHORT_COMMIT_OR_RELEASE
# `missing` pulls once; `always` pulls on every `up` (stage); `never` for
# images built locally with `docker compose build`.
BRIDGE_PULL_POLICY=missing

# The two roots (bridge-audit#132). On a stage host: /opt on the mirrored
# system volume, /mnt/data on the large volume.
#   $BRIDGE_OPT/env/<service>.env, $BRIDGE_OPT/keys/, $BRIDGE_OPT/<service>/state/
#   $BRIDGE_DATA/<service>/work/, $BRIDGE_DATA/<service>/logs/, $BRIDGE_DATA/params/<prover>/
BRIDGE_OPT=/opt/bridge-shellnet
BRIDGE_DATA=/mnt/data/bridge-shellnet

# The service user: owns the state, work, logs and params directories.
BRIDGE_UID=998
BRIDGE_GID=998

# Where /metrics is published: the host's address on the monitoring network,
# never 0.0.0.0. Required.
METRICS_LISTEN_ADDR=CHANGEME_LAN_ADDRESS
DAEMON_LIVE_METRICS_PORT=9464
DEPOSIT_RELAYER_METRICS_PORT=9467
