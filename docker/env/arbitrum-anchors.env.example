# eth-lc-relayer arbitrum-anchors: proves the Arbitrum blocks that hold
# deposits to ArbitrumBlockVerifier on Acki Nacki. Loaded by
# docker/compose.yaml as the container's environment (env_file). Install as
# root:<bridge gid> 0640; RPC URLs may carry API keys. Paths inside the
# container are fixed by the image; none belongs here.

# Parent chain of the Arbitrum chain (Sepolia for Arbitrum Sepolia): must
# serve eth_getBlockReceipts.
PARENT_RPC_URL=CHANGEME_HTTPS_RPC
# Arbitrum JSON-RPC: must serve eth_getProof for a block a few minutes old
# (public endpoints keeping ~128 blocks fail every proof; Alchemy serves
# head-20000) and eth_getLogs in spans of --arbitrum-log-span (default
# 10000; 10 on Alchemy's free tier).
ARBITRUM_RPC_URL=CHANGEME_HTTPS_RPC
# The AckiNackiBridge on the Arbitrum chain and its deploy block.
BRIDGE_ADDRESS=CHANGEME_0x
BRIDGE_DEPLOY_BLOCK=CHANGEME

# Acki Nacki: a Block Manager that serves GraphQL and REST /v2/messages.
AN_GRAPHQL_URL=https://shellnet.ackinacki.org/graphql
# eccUSDCBridge, dapp_id::account_id. proveBlock is permissionless; the
# compose file mounts $BRIDGE_OPT/keys and sets AN_KEYS_PATH.
AN_TOKEN_BRIDGE=CHANGEME_dapp::account

RUST_LOG=info
RUST_BACKTRACE=1
