# daemon-live (relayer): Acki Nacki -> EVM, proves Acki Nacki blocks to
# AckiNackiBridge. Mounted into the container read-only as
# /run/secrets/runtime-env and sourced by its entrypoint, never container
# environment. Install as root:<bridge gid> 0640; never commit the filled file.
# Paths inside the container are fixed by the image
# (docker/relayer/container-paths.sh): the state, work and log directories
# under /data, the params with pk_cache, the BK set file at
# /run/config/bk_set.json (from $BRIDGE_OPT/keys/bk_set.json). None belongs here.

# The commit the image was built from (its SOURCE_COMMIT); preflight refuses
# another image. Optional pins of the two binaries inside it, checked when set.
EXPECTED_BRIDGE_COMMIT=CHANGEME_FULL_GIT_SHA
# EXPECTED_RELAYER_SHA256=
# EXPECTED_AGGREGATE_PROOF_SHA256=

RPC_URL=CHANGEME_AUTHENTICATED_HTTPS_RPC
# Optional comma-separated fallback endpoints, tried in order when the one
# before fails (timeout, HTTP 401/429/5xx, rate limit). Every entry must serve
# the chain EXPECTED_EVM_CHAIN_ID names; the relayer refuses to start when the
# endpoints disagree on the chain id. Logs name hosts only, so URLs with API
# keys are fine here.
# RPC_FAILOVER_URLS=
# Seconds one request to one endpoint may take before the next endpoint is
# tried (default 20).
# BRIDGE_RPC_REQUEST_TIMEOUT_SECS=20
BRIDGE_ADDRESS=CHANGEME_FRESH_BRIDGE_ADDRESS
# Block the bridge was deployed in: where the startup LayerAnchorAppended
# scan (backwards from the head) stops when a window is not covered yet.
BRIDGE_DEPLOY_BLOCK=CHANGEME_BRIDGE_DEPLOY_BLOCK
# eth_getLogs span per call of that scan (default 2000; Alchemy's free tier
# caps it at 10) and the pause between calls in ms (default 0; ~250 on a
# rate-limited RPC).
# BRIDGE_GET_LOGS_CHUNK_BLOCKS=10
# BRIDGE_GET_LOGS_PAUSE_MS=250
RELAYER_ADDRESS=CHANGEME_DEDICATED_EOA
RELAYER_PRIVATE_KEY=CHANGEME_DEDICATED_PRIVATE_KEY
MIN_RELAYER_BALANCE_WEI=20000000000000000
BRIDGE_GQL_ENDPOINT=https://shellnet.ackinacki.org/graphql
# Optional ordered failover GraphQL endpoints (comma-separated). Every request
# starts at BRIDGE_GQL_ENDPOINT, retries it BRIDGE_GQL_RETRIES_PER_ENDPOINT
# times BRIDGE_GQL_RETRY_DELAY_MS apart, then moves down this list and cycles
# until one attempt succeeds. Leave empty for a single endpoint.
BRIDGE_GQL_FAILOVER_ENDPOINTS=
# BRIDGE_GQL_RETRIES_PER_ENDPOINT=3
# BRIDGE_GQL_RETRY_DELAY_MS=1000
# BRIDGE_GQL_REQUEST_TIMEOUT_SECS=30
# BRIDGE_GQL_CONNECT_TIMEOUT_SECS=10

# sha256 of $BRIDGE_DATA/params/relayer/SHA256SUMS (finalize-params.sh).
PARAMS_MANIFEST_SHA256=CHANGEME_AFTER_PARAM_FINALIZATION
# The BK set file the bridge was deployed with ($BRIDGE_OPT/keys/bk_set.json):
# its sha256 and its commitment.
BRIDGE_BK_SET_EXPECTED_SHA256=CHANGEME_SHA256_OF_BK_SET_JSON
EXPECTED_BK_SET_COMMITMENT=CHANGEME_0x
# `file`: the BK set file is the current set. `fold_at_height`: it is the
# genesis set, and bkSetUpdates are folded onto it up to the seed.
BRIDGE_BK_SET_BOOTSTRAP=file

EXPECTED_GENESIS_PREV_ANCHOR=CHANGEME_FROM_COMPUTE_BRIDGE_ANCHORS
EXPECTED_WITHDRAW_DAPP_FR=CHANGEME_DEPLOYED_VALUE
EXPECTED_WITHDRAW_ACC_FR=CHANGEME_DEPLOYED_VALUE
EXPECTED_WITHDRAW_ALT_DST_CHAIN_ID=1
EXPECTED_WITHDRAW_ALT_DST_HOST_CHAIN_ID=11155111
EXPECTED_WITHDRAW_ALT_TOKEN_ID=3
EXPECTED_USDC_ADDRESS=CHANGEME_0x

BRIDGE_ANCHOR_LEVEL=2
BRIDGE_BOOTSTRAP_SEQNO=CHANGEME_W2_ALIGNED_GENESIS_SEED
# Decimal chain id of the network the bridge is deployed on: 11155111 Sepolia,
# 421614 Arbitrum Sepolia. Every RPC endpoint above must serve it.
EXPECTED_EVM_CHAIN_ID=421614

RUST_LOG=info,bridge_relayer_daemon=info,bridge_prover_lib=info
RUST_BACKTRACE=1
