# deposit-relayer daemon: EVM -> Acki Nacki, proves Deposit events and
# finalizes them on eccUSDCBridge. Loaded by docker/compose.yaml as the
# container's environment (env_file). Install as root:<bridge gid> 0640;
# RPC URLs may carry API keys. Paths inside the container are fixed by the
# image and the compose file; none belongs here.

# The EVM chain the bridge is deployed on: its JSON-RPC must serve
# eth_getLogs over the scan window (publicnode-class endpoints do; a
# 10-block cap needs the window flags below).
RPC_URL=CHANGEME_HTTPS_RPC
# The AckiNackiBridge on that chain and the block it was deployed in: the log
# scan starts there until the state records a cursor.
BRIDGE_ADDRESS=CHANGEME_0x
BRIDGE_DEPLOY_BLOCK=CHANGEME
# Optional: the chain id the RPC must serve (checked at start).
# BRIDGE_DEPOSIT_EXPECT_CHAIN_ID=421614

# Acki Nacki: a Block Manager that serves GraphQL and REST /v2/messages.
AN_GRAPHQL_URL=https://shellnet.ackinacki.org/graphql
# eccUSDCBridge and the signer, dapp_id::account_id. The signer's key file is
# $BRIDGE_OPT/keys/deposit-sender.keys.json (mounted as /run/keys; AN_KEYS_PATH
# is set by the compose file).
AN_TOKEN_BRIDGE=CHANGEME_dapp::account
AN_SENDER=CHANGEME_dapp::account
# Bound into the proof's dappId public inputs; the bridge pins it to 0.
AN_DAPP_ID=0

# Retries and parking (see `deposit-relayer daemon --help`).
# SKIP_AFTER_ATTEMPTS=0
# OUTSTANDING_BACKOFF_SECS=2
# ANCHOR_WAIT_WARN_AFTER_SECS=0

RUST_LOG=info
RUST_BACKTRACE=1
