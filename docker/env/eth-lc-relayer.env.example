# eth-lc-relayer daemon: the Ethereum beacon light client on Acki Nacki.
# Loaded by docker/compose.yaml as the container's environment (env_file).
# Install as root:<bridge gid> 0640; RPC URLs may carry API keys. Paths
# inside the container (provers, SRS, step key, the three directories) are
# fixed by the image; none belongs here. Flags without a variable
# (--owner-hop, --rotate-timeout-secs, --poll-secs ...) are the service's `command` in
# the compose file.

# Beacon REST with the light-client endpoints enabled.
BEACON_URL=https://lodestar-sepolia.chainsafe.io
# Execution JSON-RPC for the ancestry spans (eth_getBlockByHash).
ETH_RPC_URL=CHANGEME_HTTPS_RPC
# SUBMIT_ANCESTRY stays unset: arbitrum-anchors sends the span each
# assertion's Sepolia block needs.

# Acki Nacki: a Block Manager that serves GraphQL and REST /v2/messages.
AN_GRAPHQL_URL=https://shellnet.ackinacki.org/graphql
# The light client and the sender, dapp_id::account_id. The owner key file is
# $BRIDGE_OPT/keys/an-owner.keys.json (mounted as /run/keys; AN_KEYS_PATH is
# set by the compose file).
AN_LIGHT_CLIENT=CHANGEME_account::account
AN_SENDER=CHANGEME_account::account
# eccBridge, for the owner flip (only with --flip-owner).
AN_USDC_BRIDGE=CHANGEME_dapp::account

RUST_LOG=info
RUST_BACKTRACE=1
