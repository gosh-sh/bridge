# AN→ETH bridge relayer — Sepolia verifyBlock + withdrawByProof
# Copy to /home/ubuntu/bridge-e2e/config/bridge-relayer.env and fill secrets.

# Must serve full log history (the startup scan of `daemon-live` and the
# CLI) and accept the relayer's transactions. The EF DevOps endpoint does
# both. publicnode (https://ethereum-sepolia-rpc.publicnode.com) keeps only
# the newest ~10 000 blocks of logs; Tenderly's public gateway has the
# history but answered applyBkSetUpdate sends with -32005 (rate limit).
RPC_URL=https://rpc.sepolia.ethpandaops.io
# Seconds one request to RPC_URL may take before it fails and is retried
# (default 60).
# BRIDGE_RPC_REQUEST_TIMEOUT_SECS=60
# Set the address of the paired fresh deployment, also used by the deposit relayer.
BRIDGE_ADDRESS=
# Anchor level of the bridge's bundles: 1 (stride 1024) or 2 (16384). The
# relayer reads the stride from the bridge's bundleStride(); a bridge
# deployed before that field cannot answer, and without this line the
# relayer does not start. When both are known they must agree.
BRIDGE_ANCHOR_LEVEL=2

# Startup LayerAnchorAppended scan (read_full_state): run by `daemon-live`
# and by the withdrawal CLI, not by the `daemon-bridge` this unit starts.
# Kept here so one env file serves both daemons. Lower bound = the block
# the new bridge was deployed in. Same value as the deposit relayer;
# unset means that a failed scan walks back to genesis.
# BRIDGE_DEPLOY_BLOCK=<new-bridge-deployment-block>
# Inclusive block span of one eth_getLogs call in that scan (default 2000).
# Set it to the RPC's cap: Alchemy's free tier allows 10.
# BRIDGE_GET_LOGS_CHUNK_BLOCKS=10
# Milliseconds between two eth_getLogs calls of that scan (default 0); the
# free tier also rate-limits, ~4 calls per second, so pause 250 there.
# BRIDGE_GET_LOGS_PAUSE_MS=250

# Sepolia EOA with ETH for gas (hex, no 0x prefix).
RELAYER_PRIVATE_KEY=

# Partner prover daemon output directory.
PROVER_PROOFS_DIR=/home/ubuntu/bridge-e2e/acki-nacki-to-eth-bridge-halo2-prover/proofs

# Optional BK-rotation sentry: pauses verifyBlock on a live BK rotation.
# MUST point at an AN node that serves the /v2/bk_set{,_update} REST endpoints
# (e.g. http://<an-node-host>:8600). shellnet.ackinacki.org exposes only GraphQL
# (returns 404 on /v2/bk_set_update), so leave this commented for shellnet.
# `daemon-prover` reads AN_NODE_URL from the env even without the CLI flag, so
# commenting it out is what actually disables the sentry.
#AN_NODE_URL=http://<an-node-host>:8600

# Persisted cursor (last verified block_seq_no + retry counters).
RELAYER_STATE=/home/ubuntu/bridge-e2e/state/bridge-relayer-state.json
