# AN→ETH bridge relayer — Sepolia verifyBlock + withdrawByProof
# Copy to /home/ubuntu/bridge-e2e/config/bridge-relayer.env and fill secrets.

RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BRIDGE_ADDRESS=0x99c37fb75326ae6953ebbbdcd261ec331df4ce82

# Sepolia EOA with ETH for gas (hex, no 0x prefix).
RELAYER_PRIVATE_KEY=

# Partner prover daemon output directory.
PROVER_PROOFS_DIR=/home/ubuntu/bridge-e2e/acki-nacki-to-eth-bridge-halo2-prover/proofs

# Optional BK-rotation sentry: pauses verifyBlock on a live BK rotation.
# MUST point at an AN node that serves the /v2/bk_set{,_update} REST endpoints
# (e.g. http://<an-node-host>:8600). shellnet.ackinacki.org exposes only GraphQL
# (returns 404 on /v2/bk_set_update), so leave this commented for shellnet.
# `daemon-prover` reads AN_NODE_URL from the env even without the CLI flag, so
# commenting it out is what actually disables the sentry.
#AN_NODE_URL=http://<an-node-host>:8600

# Persisted cursor (last verified block_seq_no + retry counters).
RELAYER_STATE=/home/ubuntu/bridge-e2e/state/bridge-relayer-state.json
