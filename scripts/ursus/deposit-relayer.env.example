# EVM→AN deposit relayer — Sepolia finalizeDeposit path
# Copy to /home/ubuntu/bridge-e2e/config/deposit-relayer.env and fill deployment values and secrets.

# Must serve eth_getLogs, eth_getBlockByHash, eth_getBlockReceipts and
# transaction receipts for at least the last 7 days (30 preferred), so the
# relayer can still build a deposit's receipt proof after a stall.
# An endpoint that keeps only ~10 000 blocks does not qualify. On a start
# without a state file it must also reach back to FROM_BLOCK.
RPC_URL=https://rpc.sepolia.ethpandaops.io
# Required: fresh AckiNackiBridge with deposit(address,uint256,bytes32), paired with
# eccBridge 1.17.0. Old workchain-bearing deployments are incompatible.
BRIDGE_ADDRESS=

# Required deployment block of the new bridge. Use the same block for FROM_BLOCK.
BRIDGE_DEPLOY_BLOCK=

# Lower bound consumed by the systemd unit's `--from-block`: the log scan
# starts here until state.json records `scan_done_through_block`. It must not
# be above the oldest deposit the daemon has yet to deliver, or every tick
# fails with an error naming the blocks it scanned. The first scan walks from
# here to that deposit in 10-block eth_getLogs calls, so keep it close below.
# After that the daemon scans from its last delivered deposit, and a tick
# with no new deposit makes no eth_getLogs call at all.
FROM_BLOCK=

# Acki Nacki shellnet (finalizeDeposit submit).
# AN_GRAPHQL_URL must be a node that serves GraphQL *and* `/v2/messages`
# (tvm_client 3.0 send_message). A public gateway that only answers
# `/graphql` is not enough.
AN_NODE_URL=https://shellnet.ackinacki.org
AN_GRAPHQL_URL=
AN_KEYS_PATH=
AN_TOKEN_BRIDGE=
AN_SENDER=
# Directory of deposit-relayer-state.json and its lock (--state-dir). Exactly
# one daemon per directory; a second one fails to take the lock. Back it up
# with the keys: it lists the parked deposit ids nobody else records. An old
# DEPOSIT_RELAYER_STATE line must go: the daemon refuses to start with it.
DEPOSIT_RELAYER_STATE_DIR=/home/ubuntu/bridge-e2e/state
# Directory of the daemon's own daily log files (--log-dir).
DEPOSIT_RELAYER_LOG_DIR=/home/ubuntu/bridge-e2e/logs/deposit-relayer

# Fresh-start cursor (ignored once state.json has recorded progress). Set past
# deposits already finalized on the current AN bridge so the daemon starts at
# the next unprocessed depositId.
START_DEPOSIT_ID=0

# prove-one fast path (optional; skips eth_getLogs when rebuilding a known tx's witness):
# DEPOSIT_TX_HASH=0x<confirmed-deposit-transaction>
# DEPOSIT_LOG_INDEX=2

# Optional: park a stuck depositId after N failed attempts and stop retrying
# it (0 = disabled). Waiting for a new deposit or its AN block anchor is not
# a failed attempt. The daemon reads this variable itself; the unit does not pass
# --skip-after-attempts. Parked ids stay in state.json → parked_deposit_ids
# (gauge deposit_relayer_parked_deposits) across restarts; run finalize-one
# for them. Failed, pending and anchor-waiting deposits stay in
# outstanding_deposits. Ready retries alternate with new work and use the
# stored tx with per-id backoff; they do not hold the log-scan cursor.
# A new anchor wait resets the daemon delay to --backoff-initial-secs.
# Repeat waits preserve failure backoff; with no failures, they reset idle delay.
# A state.json from an
# earlier relayer that has no stored tx is scanned from FROM_BLOCK instead.
# Deposits the AN bridge
# cannot accept (a log of another shape, a receipt proof too large to send) are skipped at once whatever this says and listed separately
# in state.json → unprovable_deposit_ids (gauge
# deposit_relayer_unprovable_deposits); finalize-one cannot help those —
# only the EVM bridge operator can return their funds.
# SKIP_AFTER_ATTEMPTS=64
# Base delay (seconds) before retrying an outstanding deposit. Doubled on
# each later failure of that id, up to 64×. Default 2.
# Anchor waits also use age/4 seconds (capped at 60), without shortening
# failure backoff. 0 disables both base and age-based per-id delays.
# OUTSTANDING_BACKOFF_SECS=2

# Delay before logging an anchor-wait warning (seconds). Default 0 warns at
# once, then at most every 15 minutes per deposit, including after restarts.
# A missing anchor can require manual admission; choose a positive delay only
# when block coverage is monitored separately and delivery latency is known.
# ANCHOR_WAIT_WARN_AFTER_SECS=0

# Prometheus text exporter of the daemon (`GET /metrics`); unset = none.
# Bind to a monitoring-only interface or loopback; the metric names are listed
# in `deposit_relayer_daemon::metrics`.
DEPOSIT_RELAYER_METRICS_ADDR=127.0.0.1:9467
