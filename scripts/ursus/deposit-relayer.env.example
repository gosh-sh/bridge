# EVM→AN deposit relayer — Sepolia finalizeDeposit path
# Copy to /home/ubuntu/bridge-e2e/config/deposit-relayer.env and fill secrets.

RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BRIDGE_ADDRESS=0x99c37fb75326ae6953ebbbdcd261ec331df4ce82

# Lower bound for eth_getLogs scans (bridge deploy block, not genesis).
# Shellnet Sepolia bridge: first deposit mined at block 11025192; use a
# slightly earlier bound.
BRIDGE_DEPLOY_BLOCK=11025180

# Lower bound consumed by the systemd unit's `--from-block`: the log scan
# starts here until state.json records `scan_done_through_block`. It must not
# be above the oldest deposit the daemon has yet to deliver, or every tick
# fails with an error naming the blocks it scanned. The first scan walks from
# here to that deposit in 10-block eth_getLogs calls, so keep it close below.
# After that the daemon scans from its last delivered deposit, and a tick
# with no new deposit makes no eth_getLogs call at all.
FROM_BLOCK=11196600

# Acki Nacki shellnet (finalizeDeposit submit).
# AN_GRAPHQL_URL must be a node that serves GraphQL *and* `/v2/messages`
# (tvm_client 3.0 send_message). A public gateway that only answers
# `/graphql` is not enough.
AN_NODE_URL=https://shellnet.ackinacki.org
AN_GRAPHQL_URL=
AN_KEYS_PATH=
AN_BRIDGE_ABI_PATH=
AN_TOKEN_BRIDGE=
AN_SENDER=
# Bound into the proof's dappId public inputs. eccUSDCBridge pins the deposit's
# dappId to 0 and does not read these inputs, so leave it at 0.
AN_DAPP_ID=0
# (AN_TOKEN_ID removed: the deployed finalizeDeposit(bytes proof, bytes
# publicInputs) ABI takes no token id — the contract is hardcoded to ECC[3] USDC.)

DEPOSIT_PROVER_DIR=/home/ubuntu/bridge-e2e/acki-nacki-bridge/deposit-prover
# Where the daemon keeps state.json (read as --state). Exactly one daemon per
# file; a second one fails to take the `.lock` next to it. Back it up with the
# keys: it lists the parked deposit ids nobody else records.
DEPOSIT_RELAYER_STATE=/home/ubuntu/bridge-e2e/state/deposit-relayer-state.json

# Fresh-start cursor (ignored once state.json has recorded progress). Set past
# deposits already finalized on the current AN bridge so the daemon starts at
# the next unprocessed depositId.
START_DEPOSIT_ID=7

# prove-one fast path (optional; skips eth_getLogs when reproving a known tx):
# DEPOSIT_TX_HASH=0x9ac341666f70d55780f289187c11a0537a52f7381e5c4b1ebe6f671314552adf
# DEPOSIT_LOG_INDEX=2

# Optional: park a stuck depositId after N failed attempts and advance
# (0 = disabled). Waiting for a deposit nobody has made yet is not a failed
# attempt. The daemon reads this variable itself; the unit does not pass
# --skip-after-attempts. Parked ids are listed in state.json →
# parked_deposit_ids (gauge deposit_relayer_parked_deposits); run
# finalize-one for them. Deposits the circuit cannot prove are skipped
# at once whatever this says and listed separately in state.json →
# unprovable_deposit_ids (gauge deposit_relayer_unprovable_deposits);
# finalize-one cannot help those — only the EVM bridge operator can
# return their funds.
# SKIP_AFTER_ATTEMPTS=64

# Prometheus text exporter of the daemon (`GET /metrics`); unset = none.
# Bind to a monitoring-only interface or loopback; the metric names are listed
# in `deposit_relayer_daemon::metrics`.
DEPOSIT_RELAYER_METRICS_ADDR=127.0.0.1:9467
