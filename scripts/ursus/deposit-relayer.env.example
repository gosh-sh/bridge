# EVM→AN deposit relayer — Sepolia finalizeDeposit path
# Copy to /home/ubuntu/bridge-e2e/config/deposit-relayer.env and fill secrets.

RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BRIDGE_ADDRESS=0x99c37fb75326ae6953ebbbdcd261ec331df4ce82

# Lower bound for eth_getLogs scans (bridge deploy block, not genesis).
# Shellnet Sepolia bridge: first deposit mined at block 11025192; use a
# slightly earlier bound.
BRIDGE_DEPLOY_BLOCK=11025180

# Lower bound consumed by the systemd unit's `--from-block`.
# The daemon persists `scanned_through_block` in state.json and only scans
# new blocks on each tick (QC-OFF-10). Still keep FROM_BLOCK near the deposits
# you care about — a very stale bound forces a large one-time catch-up scan
# on first start after deploy.
FROM_BLOCK=11196600

# Acki Nacki shellnet (finalizeDeposit submit).
AN_NODE_URL=https://shellnet.ackinacki.org
AN_GRAPHQL_URL=
AN_KEYS_PATH=
AN_BRIDGE_ABI_PATH=
AN_TOKEN_BRIDGE=
AN_SENDER=
# Required non-zero for live daemon (QC-OFF-09). Silent default "0" is rejected
# unless --dry-run. Must match the USDCBridge dapp namespace / EXPECTED_DAPP_ID
# once BC-AN-01 lands on-chain.
AN_DAPP_ID=0x1a1a1a1a1a
# (AN_TOKEN_ID removed: the deployed finalizeDeposit(bytes proof, bytes
# publicInputs) ABI takes no token id — the contract is hardcoded to ECC[3] USDC.)

DEPOSIT_PROVER_DIR=/home/ubuntu/bridge-e2e/acki-nacki-bridge/deposit-prover
DEPOSIT_RELAYER_STATE=/home/ubuntu/bridge-e2e/state/deposit-relayer-state.json

# Fresh-start cursor (ignored once state.json has recorded progress). Set past
# deposits already finalized on the current AN bridge so the daemon starts at
# the next unprocessed depositId.
START_DEPOSIT_ID=7

# prove-one fast path (optional; skips eth_getLogs when reproving a known tx):
# DEPOSIT_TX_HASH=0x9ac341666f70d55780f289187c11a0537a52f7381e5c4b1ebe6f671314552adf
# DEPOSIT_LOG_INDEX=2

# QC-OFF-01: park a stuck depositId after N consecutive failures and advance
# the cursor (0 = disabled / strict sequential). Production default is 64.
# Parked ids land in state.json → parked_deposit_ids; run finalize-one.
SKIP_AFTER_ATTEMPTS=64
