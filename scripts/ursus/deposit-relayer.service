[Unit]
Description=EVM to AN deposit relayer (shellnet finalizeDeposit)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bridge-e2e
EnvironmentFile=/home/ubuntu/bridge-e2e/config/deposit-relayer.env
Environment=PATH=/home/ubuntu/bridge-e2e/bin:/usr/bin:/bin
# NOTE: no --dry-run — this actually submits finalizeDeposit on AN.
# --start-deposit-id is the fresh-start cursor (ignored once state.json has
# progress); bump it past already-finalized deposits so the daemon doesn't
# waste ticks re-checking them. --from-block (FROM_BLOCK) must not be above the
# oldest deposit still to deliver — see deposit-relayer.env.example.
ExecStart=/home/ubuntu/bridge-e2e/bin/deposit-relayer daemon \
  --state-dir ${DEPOSIT_RELAYER_STATE_DIR} \
  --log-dir ${DEPOSIT_RELAYER_LOG_DIR} \
  --rpc-url ${RPC_URL} \
  --bridge-address ${BRIDGE_ADDRESS} \
  --from-block ${FROM_BLOCK} \
  --confirmations 3 \
  --an-graphql-url ${AN_GRAPHQL_URL} \
  --an-keys-path ${AN_KEYS_PATH} \
  --an-token-bridge ${AN_TOKEN_BRIDGE} \
  --an-sender ${AN_SENDER} \
  --start-deposit-id ${START_DEPOSIT_ID}
Restart=on-failure
RestartSec=30
# A single tick can take a while (RPC reads, the AN send and its wait);
# shutdown is only checked between ticks, so give the process room to finish the
# current tick before systemd escalates to SIGKILL (default 90s was marking a
# busy-but-healthy daemon as "failed").
TimeoutStopSec=180
KillMode=mixed

[Install]
WantedBy=multi-user.target
