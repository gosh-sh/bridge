# Beacon REST (Lodestar public CORS endpoint; replace with a dedicated node).
BEACON_URL=https://lodestar-mainnet.chainsafe.io

# The daemon writes only into these (the rotate's proving keys aside, which go
# to LIGHT_CLIENT_PROVER_DIR/rotate-keys/). The state directory holds the state
# file and its lock and must survive restarts; the rotate keeps its partial
# stages under the work directory, rotate-<P>/.
ETH_LC_RELAYER_STATE_DIR=/home/ubuntu/bridge-e2e/eth-lc-relayer/state
ETH_LC_RELAYER_WORK_DIR=/home/ubuntu/bridge-e2e/eth-lc-relayer/work
ETH_LC_RELAYER_LOG_DIR=/home/ubuntu/bridge-e2e/eth-lc-relayer/logs

# Live prove (n14). Required by the systemd unit: the prebuilt provers
# (`cargo build --release --example export_step_vk_blob` and
# `cargo build --release --features aggregation --example export_shard_snark
# --example export_step_snark --example rotate_tree_n8` in
# eth-light-client-prover/), checked to exist and be executable at startup,
# and the rotate stages' working directory: it must hold kzg_bn254_21.srs (the
# release asset) and kzg_bn254_20.srs, cut from it with
# `cargo run --release --example downsize_srs -- --input kzg_bn254_21.srs
# --output kzg_bn254_20.srs --k 20` in eth-light-client-prover/; the stages
# keep their proving keys (~40 GB) in rotate-keys/.
LIGHT_CLIENT_STEP_PROVER_BIN=/home/ubuntu/bridge-e2e/acki-nacki-bridge/eth-light-client-prover/target/release/examples/export_step_vk_blob
LIGHT_CLIENT_SHARD_PROVER_BIN=/home/ubuntu/bridge-e2e/acki-nacki-bridge/eth-light-client-prover/target/release/examples/export_shard_snark
LIGHT_CLIENT_STEP_SNARK_PROVER_BIN=/home/ubuntu/bridge-e2e/acki-nacki-bridge/eth-light-client-prover/target/release/examples/export_step_snark
LIGHT_CLIENT_ROTATE_PROVER_BIN=/home/ubuntu/bridge-e2e/acki-nacki-bridge/eth-light-client-prover/target/release/examples/rotate_tree_n8
LIGHT_CLIENT_PROVER_DIR=/home/ubuntu/bridge-e2e/acki-nacki-bridge/eth-light-client-prover
STEP_SRS_PATH=/home/ubuntu/srs/hermez-raw-19

# AN submit (required unless you add --dry-run to ExecStart)
AN_GRAPHQL_URL=https://shellnet.ackinacki.org/graphql
AN_KEYS_PATH=/home/ubuntu/bridge-e2e/config/an-keys.json
AN_LIGHT_CLIENT=dapp_id::account_id
AN_SENDER=dapp_id::account_id

# USDCBridge for the owner flip (getLightClient(l1ChainId) check +
# disableOwnerAnchorsOn). Needs a 1.9.0 bridge.
# Relayer keys must be the owner pubkey. The daemon flips only with
# --flip-owner (see scripts/ursus/flip_deposit_to_light_client.md); or run
# `eth-lc-relayer flip-owner`.
AN_USDC_BRIDGE=dapp_id::account_id

# Execution JSON-RPC. When set, the daemon fetches the span back to the previous
# accepted checkpoint and checks it locally (`link_headers`). It sends
# `submitAncestry` only with --submit-ancestry; without that flag only
# checkpoint blocks get anchors.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Rotate is on by default and needs tvm-sdk#284 (v3.1.0.an) on the nodes.
# Shadow/laptop: pass --no-rotate on ExecStart so the daemon does not start
# a rotate prove (~75 GB RSS at peak with a step beside it) every period.
