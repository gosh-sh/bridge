[Unit]
Description=Ethereum beacon light-client relayer (EthBeaconLightClient.submitUpdate)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bridge-e2e
Environment=BEACON_URL=https://lodestar-mainnet.chainsafe.io
EnvironmentFile=/home/ubuntu/bridge-e2e/config/eth-light-client-relayer.env
Environment=PATH=/home/ubuntu/bridge-e2e/bin:/home/ubuntu/.cargo/bin:/usr/bin:/bin
# Default is shadow mode (--dry-run --mock-prove) until the AN contract is
# deployed and n14 prove is wired. Drop those flags in the env file for live.
ExecStart=/home/ubuntu/bridge-e2e/bin/eth-lc-relayer daemon \
  --beacon-url ${BEACON_URL} \
  --state /home/ubuntu/bridge-e2e/eth-lc-relayer-state.json \
  --dry-run \
  --mock-prove
Restart=on-failure
RestartSec=30
TimeoutStopSec=180
KillMode=mixed

[Install]
WantedBy=multi-user.target
